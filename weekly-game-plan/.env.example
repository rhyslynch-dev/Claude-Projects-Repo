# Weekly Game Plan — required configuration
#
# LOCAL DEVELOPMENT
#   Copy this file to `.env` and fill in the real values.
#   `.env` is gitignored and must never be committed.
#
# AZURE APP SERVICE
#   Do NOT deploy a .env file. Set these as Application Settings under
#   Configuration in the App Service, which exposes them as environment
#   variables to the process.

# ── HiBob API (required for the Team Leave panel) ─────────────────────────────
# Service user credentials from HiBob. The service user needs read access to
# the Time Off endpoints. Obtain from whoever administers your HiBob tenant.
HIBOB_SERVICE_ID=SERVICE-XXXXX
HIBOB_TOKEN=

# ── Port (optional) ──────────────────────────────────────────────────────────
# Defaults to 3000 when unset. Azure App Service injects PORT automatically,
# so leave this unset in hosted environments.
# PORT=3000

# ── TLS bypass (optional — leave unset in hosted environments) ────────────────
# Set to "true" ONLY on a network that intercepts HTTPS with a self-signed
# root certificate, which makes the HiBob call fail with
# SELF_SIGNED_CERT_IN_CHAIN. This disables certificate validation and must
# not be enabled on Azure.
# HIBOB_INSECURE_TLS=true
